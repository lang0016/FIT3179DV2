        "filled": true,
        "size": 80,
        "color": "#174a67",
        "stroke": "#ffffff",
        "strokeWidth": 1.5,
        "yOffset": {
          "expr": "datum.pointOffset"
        }
      },
      "encoding": {
        "opacity": {
          "value": 1
        },
        "stroke": {
          "condition": {
            "test": "sectorFocus !== 'All sectors' && datum.sector === sectorFocus",
            "value": "#233942"
          },
          "value": "#ffffff"
        },
        "strokeWidth": {
          "condition": {
            "test": "sectorFocus !== 'All sectors' && datum.sector === sectorFocus",
            "value": 2.5
          },
          "value": 1.5
        },
        "tooltip": [
          {
            "field": "state",
            "title": "State",
            "type": "nominal"
          },
          {
            "field": "sector",
            "title": "Sector",
            "type": "nominal"
          },
          {
            "field": "share",
            "title": "Share (%)",
            "type": "quantitative",
            "format": ".1f"
          },
          {
            "field": "n",
            "title": "Eligible states",
            "type": "quantitative",
            "format": ",.0f"
          }
        ]
      },
      "transform": [
        {
          "window": [
            {
              "op": "row_number",
              "as": "pointRank"
            }
          ],
          "groupby": [
            "sector"
          ],
          "sort": [
            {
              "field": "share",
              "order": "ascending"
            },
            {
              "field": "state",
              "order": "ascending"
            }
          ]
        },
        {
          "calculate": "((datum.pointRank - 1) % (width < 300 ? 5 : 3) - (width < 300 ? 2 : 1)) * 11",
          "as": "pointOffset"
        }
      ]
    }
  ],
