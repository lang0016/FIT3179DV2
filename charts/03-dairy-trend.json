      "field": "year",
      "type": "quantitative",
      "axis": {
        "title": "Financial year ending June",
        "format": "d",
        "tickCount": 5
      },
      "scale": {
        "zero": false
      }
    },
    "y": {
      "field": "farms",
      "type": "quantitative",
      "axis": {
        "title": "Registered dairy farms"
      },
      "scale": {
        "domain": [
          0,
          7400
        ]
      }
    },
    "tooltip": [
      {
        "field": "season",
        "title": "Season",
        "type": "nominal"
      },
