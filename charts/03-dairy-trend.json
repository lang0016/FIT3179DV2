  "layer": [
    {
      "mark": {
        "type": "line",
        "color": "#6e4b87",
        "strokeWidth": 3,
        "point": {
          "filled": true,
          "size": 28
        }
      }
    },
    {
      "transform": [
        {
          "filter": "datum.year === 2012 || datum.year === 2025"
        }
      ],
      "mark": {
        "type": "text",
        "dy": {
          "expr": "datum.year === 2025 ? -32 : -15"
        },
        "dx": {
          "expr": "datum.year === 2012 ? 24 : -23"
        },
        "fontWeight": 600,
        "color": "#6e4b87"
      },
      "encoding": {
        "text": {
          "field": "farms",
          "format": ","
        }
      }
    }
  ],
  "usermeta": {
    "chart": 3,
    "title": "Fewer registered dairy farms",
    "finding": "Registered dairy farms fell 44.3%, from 6,770 to 3,772.",
    "source": "https://www.dairyaustralia.com.au/industry-reports/australian-dairy-industry-in-focus",
    "period": "2011\u201312 to 2024\u201325",
    "idiom": "Line chart"
  },
  "description": "Registered dairy farms fell 44.3%, from 6,770 to 3,772. This is a dairy-only series, not a count of all farms. The financial year runs July\u2013June; 2024\u201325 is provisional."
