{
  "$schema": "https://vega.github.io/schema/vega/v5.json",
  "width": 1000,
  "height": 400,
  "padding": 0,
  "background": "#f7f5ef",
  "autosize": {
    "type": "fit",
    "contains": "padding",
    "resize": true
  },
  "data": [
    {
      "name": "tree",
      "values": [
        {
          "id": "root",
          "parent": null,
          "label": "Agriculture",
          "value": 0
        },
        {
          "id": "0",
          "parent": "root",
          "label": "No employees",
          "value": 109401
        },
        {
          "id": "1",
          "parent": "with-employees",
          "label": "1\u20134 employees",
          "value": 26014
        },
        {
          "id": "2",
          "parent": "with-employees",
          "label": "5\u201319 employees",
          "value": 7789
        },
        {
          "id": "3",
          "parent": "with-employees",
          "label": "20\u2013199 employees",
          "value": 1419
        },
        {
          "id": "4",
          "parent": "with-employees",
          "label": "200 or more employees",
          "value": 55
        },
        {
          "id": "with-employees",
          "parent": "root",
          "label": "With employees",
          "value": 0
        }
      ],
      "transform": [
        {
          "type": "stratify",
          "key": "id",
          "parentKey": "parent"
        },
        {
          "type": "treemap",
          "field": "value",
          "sort": {
            "field": "value",
            "order": "descending"
          },
          "method": "slicedice",
          "size": [
            {
              "signal": "width * 0.53"
            },
            {
              "signal": "height - 12"
            }
          ],
          "paddingInner": 0,
          "paddingTop": 28,
          "round": false
        }
      ]
    },
    {
      "name": "groups",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.id === 'with-employees'"
        }
      ]
    },
    {
      "name": "leaves",
      "source": "tree",
      "transform": [
        {
          "type": "filter",
          "expr": "!datum.children"
        }
      ]
    },
    {
      "name": "employing",
      "source": "leaves",
      "transform": [
        {
          "type": "filter",
          "expr": "datum.parent === 'with-employees'"
        },
        {
          "type": "formula",
          "expr": "(datum.y0+datum.y1)/2",
          "as": "source_y"
        },
        {
          "type": "formula",
          "expr": "width * 0.62",
          "as": "label_x"
        },
        {
          "type": "formula",
          "expr": "70 + (toNumber(datum.id)-1)*(height-120)/3",
          "as": "label_y"
        },
        {
          "type": "linkpath",
          "shape": "diagonal",
          "orient": "horizontal",
          "sourceX": "x1",
          "sourceY": "source_y",
          "targetX": "label_x",
          "targetY": "label_y",
          "as": "leader"
        }
      ]
    }
  ],
  "marks": [
    {
      "type": "rect",
      "from": {
        "data": "groups"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "value": "#ece0cc"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x0"
          },
          "y": {
            "field": "y0"
          },
          "x2": {
            "field": "x1"
          },
          "y2": {
            "field": "y1"
          },
          "fill": {
            "signal": "datum.id === '0' ? '#174a67' : '#d6b47b'"
          },
          "stroke": {
            "signal": "datum.id === '0' ? '#f7f5ef' : '#233942'"
          },
          "strokeWidth": {
            "signal": "datum.id === '0' ? 1.5 : datum.y1-datum.y0 > 3 ? 1 : 0"
          },
          "tooltip": {
            "signal": "datum.label + ': ' + format(datum.value, ',') + ' businesses'"
          }
        }
      }
    },
    {
      "type": "rect",
      "from": {
        "data": "groups"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.x0-1.5"
          },
          "y": {
            "signal": "datum.y0-1.5"
          },
          "x2": {
            "signal": "datum.x1+1.5"
          },
          "y2": {
            "signal": "datum.y1+1.5"
          },
          "fillOpacity": {
            "value": 0
          },
          "stroke": {
            "value": "#233942"
          },
          "strokeWidth": {
            "value": 2
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "value": 5
          },
          "y": {
            "value": 17
          },
          "text": {
            "value": "Agricultural businesses"
          },
          "fill": {
            "value": "#233942"
          },
          "fontSize": {
            "signal": "width < 600 ? 11 : 13"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "groups"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "(datum.x0+datum.x1)/2"
          },
          "y": {
            "signal": "datum.y0+11"
          },
          "text": {
            "signal": "width >= 600 ? ['With','employees'] : ''"
          },
          "lineHeight": {
            "value": 12
          },
          "align": {
            "value": "center"
          },
          "fill": {
            "value": "#233942"
          },
          "fontSize": {
            "value": 12
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "(datum.x0+datum.x1)/2"
          },
          "y": {
            "signal": "(datum.y0+datum.y1)/2 - 8"
          },
          "text": {
            "signal": "datum.id === '0' ? 'No employees' : ''"
          },
          "align": {
            "value": "center"
          },
          "fill": {
            "value": "#f7f5ef"
          },
          "fontSize": {
            "signal": "width < 600 ? 12 : 16"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "leaves"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "(datum.x0+datum.x1)/2"
          },
          "y": {
            "signal": "(datum.y0+datum.y1)/2 + 17"
          },
          "text": {
            "signal": "datum.id === '0' ? format(datum.value, ',') : ''"
          },
          "align": {
            "value": "center"
          },
          "fill": {
            "value": "#f7f5ef"
          },
          "fontSize": {
            "value": 18
          },
          "fontWeight": {
            "value": 600
          }
        }
      }
    },
    {
      "type": "text",
      "encode": {
        "update": {
          "x": {
            "signal": "width*0.62"
          },
          "y": {
            "value": 28
          },
          "text": {
            "value": "With employees"
          },
          "fill": {
            "value": "#233942"
          },
          "fontSize": {
            "signal": "width < 600 ? 12 : 15"
          },
          "fontWeight": {
            "value": 600
          }
        }
      }
    },
    {
      "type": "path",
      "from": {
        "data": "employing"
      },
      "encode": {
        "update": {
          "path": {
            "field": "leader"
          },
          "stroke": {
            "value": "#53656e"
          },
          "strokeWidth": {
            "value": 1
          },
          "fillOpacity": {
            "value": 0
          }
        }
      }
    },
    {
      "type": "symbol",
      "from": {
        "data": "employing"
      },
      "encode": {
        "update": {
          "x": {
            "field": "x1"
          },
          "y": {
            "field": "source_y"
          },
          "size": {
            "value": 15
          },
          "fill": {
            "value": "#233942"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "employing"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.label_x+7"
          },
          "y": {
            "signal": "datum.label_y-5"
          },
          "text": {
            "signal": "width < 600 && datum.id === '4' ? ['200 or more','employees'] : datum.label"
          },
          "lineHeight": {
            "value": 14
          },
          "fill": {
            "value": "#233942"
          },
          "fontSize": {
            "signal": "width < 600 ? 12 : 14"
          }
        }
      }
    },
    {
      "type": "text",
      "from": {
        "data": "employing"
      },
      "encode": {
        "update": {
          "x": {
            "signal": "datum.label_x+7"
          },
          "y": {
            "signal": "datum.label_y + (width < 600 && datum.id === '4' ? 38 : 16)"
          },
          "text": {
            "signal": "format(datum.value, ',') + ' businesses'"
          },
          "fill": {
            "value": "#233942"
          },
          "fontSize": {
            "signal": "width < 600 ? 12 : 15"
          },
          "fontWeight": {
            "value": 600
          }
        }
      }
    }
  ],
  "usermeta": {
    "chart": 11,
    "title": "Most businesses have no employees",
    "finding": "About 75.6% of the derived agriculture-business total is non-employing.",
    "source": "https://www.abs.gov.au/statistics/economy/business-indicators/counts-australian-businesses-including-entries-and-exits/jul2021-jun2025",
    "period": "June 2025",
    "idiom": "Treemap"
  },
  "description": "About 75.6% of the derived agriculture-business total is non-employing. The outlined group contains businesses with employees, divided by staff count. Area counts businesses, not workers. Owners and family may still work without employees. Blue shows businesses without employees; gold shows businesses with employees. Leader lines name all four staff-size groups, including the smallest. Bin sum 144,678, versus published-class total sum 144,681: the difference reflects confidentiality adjustments."
}
